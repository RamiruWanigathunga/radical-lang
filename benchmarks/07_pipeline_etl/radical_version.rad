# Benchmark 07: Radical Left-to-Right Pipeline Operator

raw_data = list(0..5000000)
const ITERATIONS = 120

res = None
for _ in 0..ITERATIONS:
    # Linear pipeline: raw_data |> filter(...) |> map(...) |> list
    res = raw_data 
        |> filter((x) => x % 3 == 0, _) 
        |> map((x) => x * 3 + 1, _) 
        |> list

print(f"ETL Count: {len(res)}, First: {res[0]}, Last: {res[-1]}")
