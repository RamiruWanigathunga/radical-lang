# Benchmark 11: Radical Destructuring Syntax Record Extraction

records = [
    {"id": i, "name": f"user_{i % 500}", "score": (i % 100) * 1.5, "role": "admin" if i % 2 == 0 else "guest"}
    for i in 0..1000000
]
const PASSES = 400
const CHUNK_SIZE = 50000

chunks = [records[i:i + CHUNK_SIZE] for i in range(0, len(records), CHUNK_SIZE)]

fn process_chunk(chunk: list) -> tuple:
    let total_score = 0.0
    let admin_count = 0
    for _ in 0..PASSES:
        for r in chunk:
            { id, name, score, role } = r
            total_score += score
            if role == "admin":
                admin_count += 1
    return (total_score, admin_count)

results = parallel for chunk in chunks:
    return process_chunk(chunk)

score = sum(r[0] for r in results)
admins = sum(r[1] for r in results)
print(f"Total score: {score:.1f}, Admins: {admins}")
