# Benchmark 01: Radical Multi-Core Parallel Prime Computation

fn is_prime(n: int) -> bool:
    if n <= 1:
        return False
    if n <= 3:
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return False
        i += 6
    return True

results = []
parallel for n in 1..30000:
    if is_prime(n):
        results.append(1)

count = sum(results)
print(f"Primes counted: {count}")
