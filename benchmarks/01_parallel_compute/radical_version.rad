# Benchmark 01: Radical Multi-Core Parallel Prime Computation

fn is_prime(n: int) -> int:
    if n <= 1:
        return 0
    if n <= 3:
        return 1
    if n % 2 == 0 or n % 3 == 0:
        return 0
    let i = 5
    while i * i <= n:
        if n % i == 0 or n % (i + 2) == 0:
            return 0
        i += 6
    return 1

results = parallel for n in 1..16000000:
    return is_prime(n)

count = sum(results)
print(f"Primes counted: {count}")
